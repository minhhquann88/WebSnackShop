# Public base URL of the SnackShop API (browser + server). No trailing slash.
NEXT_PUBLIC_API_BASE_URL=http://localhost:5000
# Google Identity Services client id. Leave empty to hide the "Sign in with Google" button.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
# Optional: API URL used only by server-side code (SSR, BFF route handlers), e.g. http://api:8080 inside docker compose.
API_INTERNAL_URL=
# Optional: force the refresh-token cookie's Secure flag (default: true in production, false in dev).
AUTH_COOKIE_SECURE=

# Same value as the API setting RateLimiting__TrustedProxyKey (server-side only; never NEXT_PUBLIC_).
BFF_PROXY_KEY=
