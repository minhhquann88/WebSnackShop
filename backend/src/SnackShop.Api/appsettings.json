{
  "ConnectionStrings": {
    "Default": ""
  },
  "Jwt": {
    "Secret": "",
    "Issuer": "snackshop-api",
    "Audience": "snackshop-web",
    "AccessTokenMinutes": 15,
    "RefreshTokenDays": 14
  },
  "Google": {
    "ClientId": ""
  },
  "Email": {
    "Host": "localhost",
    "Port": 1025,
    "Username": "",
    "Password": "",
    "UseStartTls": false,
    "From": "SnackShop <no-reply@snackshop.local>",
    "Enabled": true
  },
  "Storage": {
    "LocalPath": "uploads",
    "PublicBaseUrl": "/uploads"
  },
  "Frontend": {
    "BaseUrl": "http://localhost:3000",
    "ShopName": "SnackShop"
  },
  "Jobs": {
    "Enabled": true,
    "IntervalMinutes": 10
  },
  "RateLimiting": {
    "AuthPerMinute": 10,
    "PlaceOrderPerMinute": 5,
    "SessionPerMinute": 120
  },
  "Seed": {
    "AdminEmail": "",
    "AdminPassword": "",
    "AdminFullName": "Administrator"
  },
  "Cors": {
    "AllowedOrigins": []
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore.Database.Command": "Warning",
        "Microsoft.EntityFrameworkCore.Query": "Error",
        "Microsoft.Hosting.Lifetime": "Information"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "formatter": "Serilog.Formatting.Compact.RenderedCompactJsonFormatter, Serilog.Formatting.Compact"
        }
      }
    ]
  },
  "AllowedHosts": "*"
}
