# Rendered by the nginx image (envsubst) into /etc/nginx/conf.d/api.conf. Only ${API_DOMAIN} and ${WEB_DOMAIN}
# are substituted; nginx's own $variables are left alone.

# Rate limiting is done by the API (per end-user IP, including sign-ins relayed by the Next.js BFF);
# limiting here by connection IP would throttle every BFF-relayed sign-in as one client.

map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}

# HTTP: ACME challenges + redirect everything else to HTTPS.
server {
    listen 80;
    listen [::]:80;
    server_name ${API_DOMAIN} ${WEB_DOMAIN};
    server_tokens off;

    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    server_name ${API_DOMAIN};
    server_tokens off;

    ssl_certificate     /etc/letsencrypt/live/${API_DOMAIN}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${API_DOMAIN}/privkey.pem;
    include /etc/nginx/snippets/tls.conf;
    include /etc/nginx/snippets/security-headers.conf;

    client_max_body_size 6m;
    gzip on;
    gzip_types application/json application/problem+json text/plain;

    # Uploaded images straight from the shared volume.
    location /uploads/ {
        alias /srv/uploads/;
        expires 7d;
        add_header Cache-Control "public";
        add_header X-Content-Type-Options "nosniff" always;
        try_files $uri =404;
    }

    # Readiness reveals DB state; keep it internal (docs/07 §8).
    location = /health/ready {
        allow 127.0.0.1;
        deny all;
        include /etc/nginx/snippets/proxy-api.conf;
    }

    # Interactive API docs are not served in Production by the app; block anyway.
    location ~ ^/(scalar|openapi) {
        return 404;
    }

    location / {
        include /etc/nginx/snippets/proxy-api.conf;
    }
}
