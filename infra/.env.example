# Copy to infra/.env on the VPS (chmod 600). Never commit the real file.
# Used by docker-compose.prod.yml (substitution) AND passed to the api container (env_file).

# ---------- Domains & images ----------
API_DOMAIN=api.snackshop.vn
# Leave empty when the frontend is on Vercel. Set it only when self-hosting with --profile web.
WEB_DOMAIN=
ACME_EMAIL=owner@snackshop.vn
API_IMAGE=ghcr.io/your-github-user/snackshop/api
API_TAG=latest
WEB_IMAGE=ghcr.io/your-github-user/snackshop/web
WEB_TAG=latest

# ---------- PostgreSQL ----------
POSTGRES_USER=snackshop
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD
POSTGRES_DB=snackshop
ConnectionStrings__Default=Host=postgres;Port=5432;Database=snackshop;Username=snackshop;Password=CHANGE_ME_STRONG_PASSWORD;Maximum Pool Size=50
BACKUP_RETENTION_DAYS=14

# ---------- JWT (generate: openssl rand -base64 64 | tr -d '\n') ----------
Jwt__Secret=CHANGE_ME_AT_LEAST_64_RANDOM_CHARACTERS________________________________
Jwt__Issuer=snackshop-api
Jwt__Audience=snackshop-web
Jwt__AccessTokenMinutes=15
Jwt__RefreshTokenDays=14

# ---------- First admin (created once if missing; change the password after first login) ----------
Seed__AdminEmail=admin@snackshop.vn
Seed__AdminPassword=CHANGE_ME_Admin12345
Seed__AdminFullName=Chu shop

# ---------- Frontend / CORS ----------
Frontend__BaseUrl=https://snackshop.vn
Frontend__ShopName=SnackShop
Cors__AllowedOrigins__0=https://snackshop.vn
Cors__AllowedOrigins__1=https://www.snackshop.vn

# ---------- BFF trust (same random value in the frontend env BFF_PROXY_KEY; openssl rand -hex 32) ----------
# Lets the Next.js auth routes pass the shopper's IP so per-IP sign-in limits apply per shopper.
RateLimiting__TrustedProxyKey=CHANGE_ME_RANDOM_HEX

# ---------- Google sign-in (empty disables it) ----------
Google__ClientId=

# ---------- SMTP (e.g. Resend, Brevo, Gmail SMTP relay) ----------
Email__Host=smtp.resend.com
Email__Port=587
Email__UseStartTls=true
Email__Username=resend
Email__Password=CHANGE_ME
Email__From=SnackShop <no-reply@snackshop.vn>
Email__Enabled=true

# ---------- Misc ----------
Serilog__MinimumLevel__Default=Information
Jobs__IntervalMinutes=10
